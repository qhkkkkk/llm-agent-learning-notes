# OpenRouter 或其他 OpenAI 兼容服务的密钥
OPENAI_API_KEY=your_api_key_here

# Tavily 搜索工具密钥
TAVILY_API_KEY=your_tavily_api_key_here

# 使用其他 OpenAI 兼容服务时修改此地址
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# 模型服务必须支持 Tool Calling 和结构化输出
MODEL_NAME=openai/gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-large

# 可选：修改示例运行时提出的问题
QUESTION=测试开发方向的主线课程有哪些？

# 可选：修改顺序写作工作流的文章主题
ARTICLE_TOPIC=人工智能的未来发展

# 可选：修改 Orchestrator-Worker 报告主题
REPORT_TOPIC=雅思与托福的区别和备考建议

# PostgreSQL Checkpointer：请替换为自己的数据库账号和密码
POSTGRES_URI=postgresql://postgres:your_password@127.0.0.1:5432/postgres?sslmode=disable

# PostgreSQL 持久化与时间旅行示例
THREAD_ID=langgraph-postgres-demo
PERSISTENCE_QUESTION=今天西安的天气如何？
FORK_QUESTION=我们之前聊过宠物相关的话题吗？

# 可选值：history、replay、fork、all
TIME_TRAVEL_MODE=history

# 限制 Checkpointer 反序列化允许的类型
LANGGRAPH_STRICT_MSGPACK=true

# LangGraph Store 长期记忆示例：memory 或 postgres
STORE_BACKEND=memory
LONG_TERM_USER_ID=user_123
MEMORY_QUERY=用户喜欢的中国音乐

# 默认模型 text-embedding-3-small 输出 1536 维向量
STORE_EMBEDDING_MODEL=text-embedding-3-small
STORE_EMBEDDING_DIMS=1536

# 跨线程个性化 Agent 示例
PERSONALIZATION_THREAD_ONE=profile-session
PERSONALIZATION_THREAD_TWO=recommend-session
PERSONALIZATION_FIRST_MESSAGE=我叫小明，身高1.75米，我喜欢川菜里的回锅肉。
PERSONALIZATION_SECOND_MESSAGE=根据我的口味推荐几道菜；如果需要最新餐厅信息，可以搜索。

# LangGraph 短期记忆管理示例
# 可选值：summary、trim、delete、clear、overwrite
SHORT_TERM_MEMORY_MODE=summary
SHORT_TERM_THREAD_ID=short-term-memory-demo
SHORT_TERM_MAX_CONTEXT_TOKENS=256
SHORT_TERM_SUMMARY_TRIGGER_MESSAGES=4
SHORT_TERM_SUMMARY_KEEP_RECENT_MESSAGES=2
SHORT_TERM_DELETE_KEEP_RECENT_MESSAGES=4

# LangGraph 人工审批与中断恢复示例
APPROVAL_THREAD_ID=approval-demo
APPROVAL_ACTION_DETAILS=模拟转账 30000 元（不会真实执行）

# 留空时程序会在终端询问；自动演示时可填写批准或拒绝
APPROVAL_DECISION=

# LangGraph 人工审阅与内容编辑示例
REVIEW_THREAD_ID=human-review-demo
REVIEW_INITIAL_TEXT=初始文章……

# 留空时程序会在终端询问；可选值：通过、编辑
REVIEW_ACTION=
REVIEW_EDITED_TEXT=编辑后的文章……

# LangGraph 邮件工具调用前人工审批示例（只模拟发送）
EMAIL_APPROVAL_THREAD_ID=email-approval-demo
EMAIL_DEMO_REQUEST=发送电子邮件至 alice@example.com，主题是：请假，内容是：回老家。

# 留空时程序会在终端询问；可选值：同意、不同意
EMAIL_REVIEW_ACTION=

# 同意时可选：只填写需要修改的字段；留空表示沿用模型生成值
EMAIL_REVIEW_TO=
EMAIL_REVIEW_SUBJECT=
EMAIL_REVIEW_BODY=

# 不同意时可选：记录取消原因
EMAIL_REVIEW_REASON=

# LangGraph 内存时间旅行示例
JOKE_TIME_TRAVEL_THREAD_ID=joke-time-travel-demo
JOKE_FORK_TOPIC=程序员趣事

# LangGraph Runtime Context 示例（不需要密钥）
RUNTIME_USER_ID=user_123

# 可选值：en、zh
RUNTIME_LANGUAGE=zh
RUNTIME_USER_NAME=小明

# LangChain 结构化天气 Agent：原生 OpenRouter 集成读取这个变量
# 与前面通过 ChatOpenAI 接入兼容地址的示例分别配置；不要提交实际密钥
OPENROUTER_API_KEY=your_openrouter_api_key_here
WEATHER_MODEL=openai/gpt-5-mini
WEATHER_THREAD_ID=11
WEATHER_USER_ID=2

# LangChain 内置摘要中间件：两个模型客户端都显式使用 OpenRouter
SUMMARY_CHAT_MODEL=openai/gpt-5-mini
SUMMARY_MODEL=openai/gpt-5-mini
SUMMARY_THREAD_ID=11

# 第 18 篇：仅用现有 OpenRouter Key 的文本输入审核
MODERATION_CHAT_MODEL=openai/gpt-5-mini
MODERATION_REVIEW_MODEL=openai/gpt-5-mini
# 可选：end、error、replace
MODERATION_EXIT_BEHAVIOR=replace
MODERATION_QUERY=北京的天气怎么样？

# 可选：仅在运行 OpenAI 官方审核参考示例时填写真正的官方 Key
# 自定义 OpenRouter 输入审核不读取这个变量
OPENAI_MODERATION_API_KEY=your_openai_api_key_here

# 第 19 篇：自定义中间件，沿用上面的 OPENROUTER_API_KEY
CUSTOM_MIDDLEWARE_MODEL=openai/gpt-5-mini
CUSTOM_MIDDLEWARE_QUERY=北京的天气如何

# 第 20 篇：两个类式中间件，沿用上面的 OPENROUTER_API_KEY
CLASS_MIDDLEWARE_MODEL=openai/gpt-5-mini
CLASS_MIDDLEWARE_QUERY=北京的天气如何

# 第 21 篇：按状态筛选工具，沿用上面的 OPENROUTER_API_KEY
DYNAMIC_TOOLS_MODEL=openai/gpt-5-mini
DYNAMIC_TOOLS_QUERY=北京的天气如何
# 只接受 true / false；这是本地演示标记，不是实际登录认证
DYNAMIC_TOOLS_AUTH=true

# 第 22 篇：按角色生成系统提示词，沿用上面的 OPENROUTER_API_KEY
DYNAMIC_PROMPT_MODEL=openai/gpt-5-mini
DYNAMIC_PROMPT_ROLE=专家
DYNAMIC_PROMPT_QUERY=解释一下机器学习

# 第 23 篇：MCP 双服务 Agent，沿用上面的 OPENROUTER_API_KEY
MCP_AGENT_MODEL=openai/gpt-5-mini
MCP_WEATHER_PORT=8000
# 可选：连接其他地址；未设置时按端口生成本机 /mcp 地址
# MCP_WEATHER_URL=http://127.0.0.1:8000/mcp
# 本机 MCP 地址绕过代理；已设置进程环境变量时以进程配置为准
NO_PROXY=127.0.0.1,localhost

# 第 24 篇：MCP 文档资源 Agent，沿用 OPENROUTER_API_KEY
MCP_DOCS_MODEL=openai/gpt-5-mini
