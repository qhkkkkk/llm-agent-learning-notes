# OpenRouter 或其他 OpenAI 兼容服务的密钥
OPENAI_API_KEY=your_api_key_here

# Tavily 搜索工具密钥
TAVILY_API_KEY=your_tavily_api_key_here

# 使用其他 OpenAI 兼容服务时修改此地址
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# 模型服务必须支持 Tool Calling 和结构化输出
MODEL_NAME=openai/gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-large

# 可选：修改示例运行时提出的问题
QUESTION=测试开发方向的主线课程有哪些？

# 可选：修改顺序写作工作流的文章主题
ARTICLE_TOPIC=人工智能的未来发展

# 可选：修改 Orchestrator-Worker 报告主题
REPORT_TOPIC=雅思与托福的区别和备考建议

# PostgreSQL Checkpointer：请替换为自己的数据库账号和密码
POSTGRES_URI=postgresql://postgres:your_password@127.0.0.1:5432/postgres?sslmode=disable

# PostgreSQL 持久化与时间旅行示例
THREAD_ID=langgraph-postgres-demo
PERSISTENCE_QUESTION=今天西安的天气如何？
FORK_QUESTION=我们之前聊过宠物相关的话题吗？

# 可选值：history、replay、fork、all
TIME_TRAVEL_MODE=history

# 限制 Checkpointer 反序列化允许的类型
LANGGRAPH_STRICT_MSGPACK=true

# LangGraph Store 长期记忆示例：memory 或 postgres
STORE_BACKEND=memory
LONG_TERM_USER_ID=user_123
MEMORY_QUERY=用户喜欢的中国音乐

# 默认模型 text-embedding-3-small 输出 1536 维向量
STORE_EMBEDDING_MODEL=text-embedding-3-small
STORE_EMBEDDING_DIMS=1536

# 跨线程个性化 Agent 示例
PERSONALIZATION_THREAD_ONE=profile-session
PERSONALIZATION_THREAD_TWO=recommend-session
PERSONALIZATION_FIRST_MESSAGE=我叫小明，身高1.75米，我喜欢川菜里的回锅肉。
PERSONALIZATION_SECOND_MESSAGE=根据我的口味推荐几道菜；如果需要最新餐厅信息，可以搜索。

# LangGraph 短期记忆管理示例
# 可选值：summary、trim、delete、clear、overwrite
SHORT_TERM_MEMORY_MODE=summary
SHORT_TERM_THREAD_ID=short-term-memory-demo
SHORT_TERM_MAX_CONTEXT_TOKENS=256
SHORT_TERM_SUMMARY_TRIGGER_MESSAGES=4
SHORT_TERM_SUMMARY_KEEP_RECENT_MESSAGES=2
SHORT_TERM_DELETE_KEEP_RECENT_MESSAGES=4
